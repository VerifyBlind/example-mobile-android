## Bu dosya ayar örneğidir. 'verifyblind.properties' (ya da 'local.properties') adıyla kopyalayın
## ve değerleri kendinize göre doldurun. Kopyalanan dosya git'e girmez.

# Partner backend'inizdeki aracı (proxy) endpoint'in taban adresi
VERIFYBLIND_PARTNER_BACKEND_URL=https://test.verifyblind.com/api/

# Taban adrese eklenen göreli yol (varsayılan: generate)
VERIFYBLIND_GENERATE_ENDPOINT=generate

# VerifyBlind App Link adresi
VERIFYBLIND_APP_LINK_BASE=https://app.verifyblind.com/request

# Sonucun sorgulandığı VerifyBlind API
VERIFYBLIND_API_URL=https://api.verifyblind.com

# İsteğe bağlı sertifika sabitleme (virgülle ayrılmış sha256 listesi)
verifyblind.certificatePins=sha256/PRIMARY_PIN,sha256/BACKUP_PIN
